{
  "entities": {
    "Campus": {
      "title": "Campus",
      "description": "Multi-campus branch information for NusaCampus.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "campusId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "appName": { "type": "string", "maxLength": 120 },
        "logo": { "type": "string", "maxLength": 1024 },
        "primaryColor": { "type": "string", "maxLength": 32 },
        "secondaryColor": { "type": "string", "maxLength": 32 },
        "contact": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["Aktif", "Renovasi", "Perluasan"] },
        "code": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "city": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "totalStudents": { "type": "number" },
        "totalLecturers": { "type": "number" }
      },
      "required": ["campusId", "name", "logo", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and campus association.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { 
          "type": "string", 
          "enum": ["Super Admin", "Admin", "Dosen", "Mahasiswa"] 
        },
        "campusId": { "type": "string", "maxLength": 64 },
        "avatar": { "type": "string", "maxLength": 1024 },
        "phone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "campusId"]
    },
    "Student": {
      "title": "Student",
      "description": "Student academic profile and credentials.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "campusId": { "type": "string", "maxLength": 64 },
        "nim": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "avatar": { "type": "string", "maxLength": 1024 },
        "faculty": { "type": "string", "maxLength": 120 },
        "major": { "type": "string", "maxLength": 120 },
        "program": { "type": "string", "maxLength": 32 },
        "semester": { "type": "number" },
        "academicYear": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "ipk": { "type": "number" },
        "totalSks": { "type": "number" },
        "targetSks": { "type": "number" },
        "uktStatus": { "type": "string", "maxLength": 32 }
      },
      "required": ["nim", "name", "email", "campusId", "major"]
    },
    "Lecturer": {
      "title": "Lecturer",
      "description": "Faculty lecturer academic profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "campusId": { "type": "string", "maxLength": 64 },
        "nip": { "type": "string", "maxLength": 32 },
        "nidn": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "room": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "avatar": { "type": "string", "maxLength": 1024 }
      },
      "required": ["nip", "name", "department", "campusId"]
    },
    "Course": {
      "title": "Course",
      "description": "Course catalog offering per campus.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "campusId": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 120 },
        "sks": { "type": "number" },
        "semester": { "type": "number" },
        "category": { "type": "string", "enum": ["Wajib", "Pilihan", "MBKM"] },
        "quota": { "type": "number" },
        "enrolled": { "type": "number" },
        "lecturer": { "type": "string", "maxLength": 120 },
        "room": { "type": "string", "maxLength": 64 },
        "schedule": { "type": "string", "maxLength": 64 },
        "isSelected": { "type": "boolean" }
      },
      "required": ["code", "name", "sks", "campusId"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Lecture schedule entry per campus.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "campusId": { "type": "string", "maxLength": 64 },
        "courseCode": { "type": "string", "maxLength": 32 },
        "courseName": { "type": "string", "maxLength": 120 },
        "sks": { "type": "number" },
        "lecturer": { "type": "string", "maxLength": 120 },
        "room": { "type": "string", "maxLength": 64 },
        "day": { "type": "string", "maxLength": 32 },
        "dayIndex": { "type": "number" },
        "timeStart": { "type": "string", "maxLength": 16 },
        "timeEnd": { "type": "string", "maxLength": 16 },
        "classGroup": { "type": "string", "maxLength": 32 }
      },
      "required": ["courseCode", "courseName", "day", "timeStart", "campusId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Campus announcements and circulars.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "campusId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 5000 },
        "author": { "type": "string", "maxLength": 120 },
        "isPinned": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["Normal", "Tinggi", "Darurat"] }
      },
      "required": ["title", "category", "date", "campusId"]
    },
    "MediaSlide": {
      "title": "MediaSlide",
      "description": "Campus media slider banner or video promo.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "campusId": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["image", "video"] },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 },
        "mediaUrl": { "type": "string", "maxLength": 1024 },
        "thumbnailUrl": { "type": "string", "maxLength": 1024 },
        "linkUrl": { "type": "string", "maxLength": 1024 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "videoDuration": { "type": "string", "maxLength": 32 }
      },
      "required": ["title", "type", "mediaUrl", "order", "isActive"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin access record for authorization checks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "role": { "type": "string", "enum": ["Super Admin", "Admin"] },
        "campusId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/campuses/{campusId}": {
      "schema": "Campus",
      "description": "Campuses list for multi-campus support."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with role and campusId."
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student academic profiles with campusId."
    },
    "/lecturers/{lecturerId}": {
      "schema": "Lecturer",
      "description": "Lecturer profiles with campusId."
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Course catalog with campusId."
    },
    "/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Class schedules with campusId."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Campus announcements with campusId."
    },
    "/mediaSlides/{slideId}": {
      "schema": "MediaSlide",
      "description": "Media carousel slides."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Trusted admin users for RBAC."
    }
  }
}
